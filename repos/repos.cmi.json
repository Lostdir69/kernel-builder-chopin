[
  {
    "kernelSource": {
      "name": "bxsjroton-release",
      "repo": "https://github.com/Lostdir69/kernel_motorola_hawaiipl/",
      "branch": "android-12.0",
      "device": "hawaiipl",
      "defconfig": "hawaiipl-perd_defconfig"
    },
    "withKernelSU": false,
    "toolchains": [
      {
        "repo": "https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86",
        "branch": "android12-platform-release",
        "name": "linux-x86-clang",
        "binPath": ["clang-r383902/bin"]
      }
    ],
    "ccache": false,
    "params": {
      "ARCH": "arm64",
      "CC": "clang",
      "externalCommand": {
        "CROSS_COMPILE": "linux-x86-clang/clang-r383902/bin/aarch64-linux-gnu-",
        "CROSS_COMPILE_ARM32": "linux-x86-clang/clang-r383902/bin/arm-linux-gnueabi-",
        "LD": "linux-x86-clang/clang-r383902/bin/ld.lld",
        "AR": "linux-x86-clang/clang-r383902/bin/llvm-ar",
        "NM": "linux-x86-clang/clang-r383902/bin/llvm-nm",
        "OBJCOPY": "linux-x86-clang/clang-r383902/bin/llvm-objcopy",
        "OBJDUMP": "linux-x86-clang/clang-r383902/bin/llvm-objdump",
        "READELF": "linux-x86-clang/clang-r383902/bin/llvm-readelf",
        "OBJSIZE": "linux-x86-clang/clang-r383902/bin/llvm-size",
        "STRIP": "linux-x86-clang/clang-r383902/bin/llvm-strip",
        "LDGOLD": "linux-x86-clang/clang-r383902/bin/aarch64-linux-gnu-ld.gold",
        "LLVM_AR": "linux-x86-clang/clang-r383902/bin/llvm-ar",
        "LLVM_DIS": "linux-x86-clang/clang-r383902/bin/llvm-dis"
    },
    "AnyKernel3": {
      "use": false,
      "release": false,
      "repo": "https://github.com/osm0sis/AnyKernel3",
      "branch": "master"
    }
  }
]
